# Copy this file to .env and fill in real values for local development.
# Only EXPO_PUBLIC_* variables are safe to ship inside the client bundle —
# see CONTRACT.md "Environment variables" for the authoritative list.
# Never commit a real .env file.

# Supabase project URL, e.g. https://xxxxxxxxxxxx.supabase.co
EXPO_PUBLIC_SUPABASE_URL=

# Supabase anon (public) API key — safe for client use under RLS.
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Cloudflare Tunnel hostname fronting Caddy + go2rtc, e.g. https://gate.example.com
EXPO_PUBLIC_VIDEO_BASE_URL=
