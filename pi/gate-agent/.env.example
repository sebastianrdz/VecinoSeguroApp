# Copy to .env and fill in real values ON THE PI ONLY. Never commit .env.
# Never commit real hostnames/keys/IPs anywhere in this repo or in chat —
# placeholders only below.

# --- Contractual (CONTRACT.md `pi/` section) — names must match exactly ---
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY
GATE_GPIO_PIN=17
GATE_PULSE_MS=500

# --- Additive (gate-agent internal concerns only; not in CONTRACT.md) ---
# mock | gpio | auto (auto picks gpio if RPi.GPIO is importable, else mock)
GATE_AGENT_MODE=auto
# Minimum milliseconds between relay pulses (debounce / anti-hammer guard).
GATE_MIN_INTERVAL_MS=2000
# Realtime reconnect backoff, seconds: starts here, doubles up to the max.
GATE_RECONNECT_BACKOFF_SECONDS=2
GATE_RECONNECT_BACKOFF_MAX_SECONDS=30
# Python logging level for the structured JSON logs.
GATE_AGENT_LOG_LEVEL=INFO
