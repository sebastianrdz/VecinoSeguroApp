# pi/.env.example
#
# Copy this file to `pi/.env` (or the real deployed path,
# /opt/vecinoseguro/pi/.env — see pi/systemd/*.service EnvironmentFile=)
# and fill in REAL values there. NEVER commit the filled-in file — it is
# already covered by the repo-root .gitignore (`.env`, `.env.*`,
# `!.env.example`). chmod 600 it and confirm ownership matches the
# relevant systemd service user (see pi/setup/SECURITY.md).
#
# Every variable below is placeholder-only. Names are CONTRACTUAL — copied
# verbatim from CONTRACT.md's `pi/` section. Do not rename any of them;
# consuming code (this component's go2rtc.yaml/Caddyfile, and the
# gate-agent component) matches these exact names.

# ── Supabase ──────────────────────────────────────────────────────────────
# Project URL, e.g. https://<project-ref>.supabase.co — used by gate-agent
# for Realtime (gate_commands) and by anything else on the Pi that talks to
# Supabase's REST/Realtime API.
SUPABASE_URL=https://<YOUR_PROJECT_REF>.supabase.co

# Service-role key (full-privilege, bypasses RLS) — used by gate-agent to
# read/update gate_commands and insert gate_events per CONTRACT.md's
# Realtime section. Treat as a master credential: never log it, never send
# it anywhere but Supabase's own API, rotate immediately on any suspected
# leak (see pi/setup/SECURITY.md).
SUPABASE_SERVICE_ROLE_KEY=<PLACEHOLDER_SERVICE_ROLE_KEY>

# ── Gate relay (GPIO) ─────────────────────────────────────────────────────
# BCM GPIO pin number driving the opto-isolated relay (see
# pi/setup/HARDWARE.md for wiring). Default per CONTRACT.md: 17.
GATE_GPIO_PIN=17

# How long to pulse the relay closed, in milliseconds, to mimic a single
# button press on the gate remote. Default per CONTRACT.md: 500.
GATE_PULSE_MS=500

# ── Cameras ───────────────────────────────────────────────────────────────
# One RTSP URL per camera, numbered from 1, matched by go2rtc.yaml to a
# `cameras.stream_key` value (see CONTRACT.md and pi/go2rtc.yaml's comments
# for the main/sub stream-naming convention). Add CAMERA_3_RTSP_URL,
# CAMERA_4_RTSP_URL, ... following the same pattern as you add cameras —
# and add a matching `streams:` entry (+ `_sub`) in pi/go2rtc.yaml for each.
#
# Placeholder format shown below matches a typical Hikvision RTSP URL
# shape (credentials + host + stream path) — replace entirely with your
# camera's real, non-committed values. NEVER put a real camera IP or
# credential in this .example file.
CAMERA_1_RTSP_URL=rtsp://<CAMERA_USER>:<CAMERA_PASSWORD>@<CAMERA_1_HOST_PLACEHOLDER>:554/Streaming/Channels/101
CAMERA_2_RTSP_URL=rtsp://<CAMERA_USER>:<CAMERA_PASSWORD>@<CAMERA_2_HOST_PLACEHOLDER>:554/Streaming/Channels/101
# CAMERA_3_RTSP_URL=rtsp://<CAMERA_USER>:<CAMERA_PASSWORD>@<CAMERA_3_HOST_PLACEHOLDER>:554/Streaming/Channels/101

# ── Cloudflare Tunnel ─────────────────────────────────────────────────────
# Token from `cloudflared tunnel create` / the Zero Trust dashboard (see
# pi/cloudflared/README.md). Used by pi/systemd/cloudflared.service's
# default token-only invocation.
CLOUDFLARE_TUNNEL_TOKEN=<PLACEHOLDER_CLOUDFLARE_TUNNEL_TOKEN>

# ── Caddy JWT validation ──────────────────────────────────────────────────
# Shared secret Supabase uses to sign JWTs (HS256, assumed for v1 per
# CONTRACT.md — see pi/Caddyfile's comments for what changes if this
# project later moves to asymmetric/JWKS signing). Find this in the
# Supabase dashboard under Project Settings -> API -> JWT Settings.
SUPABASE_JWT_SECRET=<PLACEHOLDER_SUPABASE_JWT_SECRET>

# ──────────────────────────────────────────────────────────────────────────
# gate-agent additional tuning vars (see pi/gate-agent/README.md)
#
# pi/gate-agent/ is owned by another engineer and may define a small
# number of ADDITIVE, non-contractual env vars of its own (e.g. a log
# level, a Realtime reconnect backoff, etc.) that live alongside the
# contractual vars above. This section is left here deliberately so this
# file stays the single source of truth for a fresh operator setting up
# the Pi — once pi/gate-agent/README.md documents its own vars, copy them
# in below with the same placeholder-only convention used above. No
# specific vars are invented here since that component doesn't exist yet
# at the time of writing.
# ──────────────────────────────────────────────────────────────────────────
